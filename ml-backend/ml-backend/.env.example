# Copy to file .env, and fill in. The app only reads these generic variables.

# One key per provider.
OPENAI_API_KEY=
XAI_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-4o-mini
XAI-MODEL=grok-3-latest

# Optional API Gateway. Make sure to leave blank to directly call xAI / OpenAI. 
# When set, outbound calls are routed through it, and project id is sent as a header.
LLM_GATEWAY_HOST=
LLM-GATEWAY_PROJECT_ID=
LLM_GATEWAY_HEADER=X-Project

# Server
HOST=0.0.0.0
PORT=8000
